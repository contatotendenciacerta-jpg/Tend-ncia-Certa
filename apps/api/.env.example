DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tendencia_certa
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Opcionais - deixe sem preencher (ou apague as linhas) para subir a API
# sem Stripe/Mercado Pago. Os endpoints /billing/* respondem 503 até
# essas variáveis serem configuradas; o resto da API funciona normal.
STRIPE_API_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

MERCADOPAGO_ACCESS_TOKEN=changeme
MERCADOPAGO_WEBHOOK_SECRET=changeme
MERCADOPAGO_SUCCESS_URL=http://localhost:3000/billing/success
MERCADOPAGO_FAILURE_URL=http://localhost:3000/billing/failure
MERCADOPAGO_PENDING_URL=http://localhost:3000/billing/pending
